}:service_manager find;

# allow pcc components to use UDP sockets provided by the system server but not
# modify them other than to connect
allow pcc_component system_server:udp_socket {
        connect getattr read recvfrom sendto write getopt setopt };

allow pcc_component ashmem_device:chr_file { getattr read ioctl watch watch_reads append write lock map };

# Reads from other apps fifos
allow pcc_component appdomain:fifo_file r_file_perms;

# Communication with pcc_component via fifos
allow pcc_component pcc_component:fifo_file rw_file_perms;

# Read wallpaper file (opened by system).
allow pcc_component wallpaper_file:file { getattr read map };

# Read cached ringtones (opened by system).
allow pcc_component ringtone_file:file { getattr read map };

# Allow pcc_component to read from untrusted_app memfd_file
allow pcc_component untrusted_app:memfd_file { getattr read };

# Allow pcc_components to read from app data files (subject to mls restrictions)
allow pcc_component {
  app_data_file
  privapp_data_file
}:dir r_dir_perms;
allow pcc_component {
  app_data_file
  privapp_data_file
}:{ file fifo_file lnk_file sock_file } r_file_perms;

# Allow read/write access to system apps via already open fds.
allow pcc_component system_app_data_file:file { getattr map read write };

# Allow to read staged apks.
allow pcc_component { apk_private_tmp_file apk_tmp_file }:file { getattr read };

# Allow pcc_components to view preloaded media content
allow pcc_component preloads_media_file:dir r_dir_perms;
allow pcc_component preloads_media_file:file r_file_perms;
allow pcc_component preloads_data_file:dir search;

# pcc_component needs to be able to send a SIGCHLD to runas_app
# when running under a debugger (b/123612207)
allow pcc_component runas_app:process sigchld;

# Android Studio Instant Run has the application connect to a
# runas_app socket listening in the abstract namespace.
# https://developer.android.com/studio/run/
allow pcc_component runas_app:unix_stream_socket connectto;

allow pcc_component sysfs_hwrandom:dir search;
allow pcc_component sysfs_hwrandom:file r_file_perms;

###
### neverallow rules
###

# TODO: b/442762197 - Add a neverallow rule for servicemanager services

neverallow pcc_component app_data_file_type:file execute_no_trans;

# Receive or send uevent messages.
neverallow pcc_component domain:netlink_kobject_uevent_socket *;

# Receive or send generic netlink messages
neverallow pcc_component domain:netlink_socket *;

# Too much leaky information in debugfs. It's a security
# best practice to ensure these files aren't readable.
neverallow pcc_component debugfs_type:file read;

# execute gpu_device
neverallow pcc_component gpu_device:chr_file execute;

# access files in /sys with the default sysfs label
neverallow pcc_component sysfs:file *;

# Avoid reads from generically labeled /proc files
# Create a more specific label if needed
neverallow pcc_component proc:file { no_rw_file_perms no_x_file_perms };

# Avoid mutating external storage
neverallow pcc_component { sdcard_type fuse }:file no_w_file_perms;
neverallow pcc_component { sdcard_type fuse }:dir no_w_dir_perms;

# Avoid mutating shell files
neverallow pcc_component shell_data_file:dir { write add_name remove_name create setattr };
neverallow pcc_component shell_data_file:file { write create setattr relabelfrom append unlink link rename };

# Avoid reads to proc_net, it contains too much device wide information about
# ongoing connections.
neverallow pcc_component proc_net:file no_rw_file_perms;

# Never allow pcc components to write to app sandbox directory
neverallow pcc_component {
  app_data_file
  privapp_data_file
  is_flag_enabled(RELEASE_UNLOCKED_STORAGE_API, `storage_area_content_file')
}:dir no_w_dir_perms;
neverallow pcc_component {
  app_data_file
  privapp_data_file
  is_flag_enabled(RELEASE_UNLOCKED_STORAGE_API, `storage_area_content_file')
}:{ file fifo_file lnk_file sock_file } no_w_file_perms;

# Never allow pcc components to write to untrusted_app dir/file
neverallow pcc_component untrusted_app_all:dir no_w_dir_perms;
neverallow pcc_component untrusted_app_all:lnk_file no_w_file_perms;

# Never allow pcc component to write files in visible storage
neverallow pcc_component media_rw_data_file:dir no_w_dir_perms;
neverallow pcc_component media_rw_data_file:file no_w_file_perms;

# Never allow pcc component to write to other app fifo_files
# su is allowed because of rule `allow domain su (fifo_file (write getattr))` in domain.te
neverallow pcc_component { appdomain -pcc_component -su }:fifo_file no_w_file_perms;

# Never allow pcc component to create tcp stream sockets
neverallow pcc_component pcc_component:tcp_socket create_stream_socket_perms;
neverallow pcc_component port_type:tcp_socket name_connect;

# Never allow pcc component to create udp, icmp, rawip sockets
neverallow pcc_component pcc_component:{ icmp_socket udp_socket rawip_socket } create_socket_perms;

# Only allow stream socket comms between pcc components
neverallow pcc_component { appdomain -pcc_component -su }:unix_stream_socket { getopt getattr read write shutdown };

# Never allow pcc components to write to wallpaper/ringtone
neverallow pcc_component wallpaper_file:file no_w_file_perms;
neverallow pcc_component ringtone_file:file no_w_file_perms;

# Do not allow untrusted apps to access PCC data
neverallow untrusted_app_all pcc_data_file:dir_file_class_set *;

# Never allow pcc components to write to usb serial devices
neverallow pcc_component { serial_device usb_serial_device usb_device usbaccessory_device }:chr_file { no_w_file_perms ioctl };

# Never allow pcc components to write to vendor files
neverallow pcc_component vendor_app_file:file { append write create rename setattr unlink };
neverallow pcc_component vendor_app_file:dir { write add_name remove_name create reparent rename rmdir setattr };
neverallow pcc_component vendor_app_file:lnk_file no_w_file_perms;
neverallow pcc_component vendor_microdroid_file:file { append write create rename setattr unlink };
neverallow pcc_component vendor_microdroid_file:dir { write add_name remove_name create reparent rename rmdir setattr };
neverallow pcc_component vendor_microdroid_file:lnk_file no_w_file_perms;

# Never allow pcc components to write to apk temp files
neverallow pcc_component { apk_private_tmp_file apk_tmp_file }:file no_w_file_perms;

# Never allow pcc_components to modify preloaded media content
neverallow pcc_component preloads_media_file:dir no_w_dir_perms;
neverallow pcc_component preloads_media_file:file no_w_file_perms;
neverallow pcc_component preloads_data_file:dir no_w_file_perms;

neverallow pcc_component sysfs_hwrandom:dir no_w_dir_perms;
neverallow pcc_component sysfs_hwrandom:file no_w_file_perms;
