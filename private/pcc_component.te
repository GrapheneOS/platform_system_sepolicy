### PCC components.
###
### This file defines the security policy for pcc_components.
###
### The pcc_component domain is a reduced permissions sandbox for private compute core features.
type pcc_component, domain;

typeattribute pcc_component coredomain;

net_domain(pcc_component)
app_domain(pcc_component)

# Allow pcc components to read files in visible storage.
allow pcc_component { sdcard_type fuse }:file r_without_open_file_perms;
allow pcc_component media_rw_data_file:file r_without_open_file_perms;
allow pcc_component { sdcard_type fuse media_rw_data_file }:dir r_dir_perms;

# Required to read CTS tests data from the shell_data_file location.
allow pcc_component shell_data_file:file r_file_perms;
allow pcc_component shell_data_file:dir r_dir_perms;

# Allow pcc_component to search directories and read files in /vendor/app
allow pcc_component vendor_app_file:file r_file_perms;
allow pcc_component vendor_app_file:dir r_dir_perms;

allow pcc_component vendor_microdroid_file:file r_file_perms;
allow pcc_component vendor_microdroid_file:dir r_dir_perms;

# Some apps ship with shared libraries and binaries that they write out
# to their sandbox directory and then execute.
allow pcc_component privapp_data_file:file { r_file_perms execute };
allow pcc_component app_data_file:file     { r_file_perms execute };

allow pcc_component pcc_data_file:dir create_dir_perms;
allow pcc_component pcc_data_file:file create_file_perms;
allow pcc_component pcc_data_file:lnk_file create_file_perms;

# Allow loading and deleting shared libraries created by trusted system
# components within an application home directory.
allow pcc_component app_exec_data_file:file { r_file_perms execute unlink };

# services
allow pcc_component audioserver_service:service_manager find;
allow pcc_component cameraserver_service:service_manager find;
allow pcc_component mediaserver_service:service_manager find;
allow pcc_component mediaextractor_service:service_manager find;
allow pcc_component mediametrics_service:service_manager find;
allow pcc_component mediadrmserver_service:service_manager find;
allow pcc_component drmserver_service:service_manager find;
allow pcc_component radio_service:service_manager find;

allow pcc_component {
# go/keep-sorted start
IProxyService_service
accessibility_service
account_service
activity_service
activity_task_service
alarm_service
app_search_service
appops_service
